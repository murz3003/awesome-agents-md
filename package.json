{
  "name": "awesome-agents-md",
  "version": "0.1.0",
  "private": true,
  "description": "Curated collection of universal context rules — agents.md patterns organized by domain.",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "tsx tools/converter/src/index.ts build",
    "build:agents": "tsx tools/converter/src/index.ts build --target agents",
    "build:mdc": "tsx tools/converter/src/index.ts build --target mdc",
    "build:claude": "tsx tools/converter/src/index.ts build --target claude",
    "build:skills": "tsx tools/converter/src/index.ts build --target skills",
    "clean": "tsx tools/converter/src/index.ts clean",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
